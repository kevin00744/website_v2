generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  system_admin
  general_agent
  admin
  editor
  dealer
  manager
  accountant
  staff
}

enum Region {
  A
  B
  C
}

enum DocumentType {
  disclaimer
  id_document
}

enum SignerRole {
  customer
  staff
}

enum InventoryMovementType {
  restock
  consumption
  adjustment
  transfer_in
  transfer_out
}

enum ConversationType {
  inventory_request
  customer_inquiry
  general_chat
}

enum ConversationStatus {
  open
  resolved
}

/// WebSocket 廣播「送達/已讀」事件時更新此欄位，前端不需要自己拿 lastReadAt 時間戳
/// 去回推每一則訊息的已讀狀態，直接讀 Message.status 即可。
enum MessageStatus {
  sent
  delivered
  read
}

model User {
  id        Int       @id @default(autoincrement())
  /// 登入帳號（必填，唯一），不可用 email 登入
  username  String    @unique
  /// 僅用於未來忘記密碼 / 密碼重設發送驗證信，不可作為登入帳號
  email     String?
  name      String
  password  String
  role      Role
  phone     String?
  storeId   Int?      @map("store_id")
  store     Store?    @relation(fields: [storeId], references: [id])
  isActive  Boolean   @default(true) @map("is_active")
  /// 建立者 ID（自引用），記錄該帳號由哪一個帳號建立
  parentId  Int?      @map("parent_id")
  parent    User?     @relation("UserParent", fields: [parentId], references: [id])
  children  User[]    @relation("UserParent")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdCustomers               Customer[]  @relation("CreatedBy")
  disclaimerStaffSignedCustomers Customer[]  @relation("DisclaimerStaff")
  documentStaffSignedCustomers   Customer[]  @relation("DocumentStaff")
  signatures                     Signature[]

  inventoryLogs              InventoryLog[]
  restockRequestsRequested   RestockRequest[]         @relation("RestockRequestedBy")
  restockRequestsCompleted   RestockRequest[]         @relation("RestockCompletedBy")
  forwardedContactMessages   ContactMessage[]         @relation("ContactMessageForwardedBy")
  createdConversations       Conversation[]           @relation("ConversationCreator")
  resolvedConversations    Conversation[]            @relation("ConversationResolver")
  conversationParticipants ConversationParticipant[]
  messages                 Message[]

  chatContactPermissionsOwned     ChatContactPermission[] @relation("ChatContactPermissionOwner")
  chatContactPermissionsAsContact ChatContactPermission[] @relation("ChatContactPermissionContact")
  chatContactPermissionsCreated   ChatContactPermission[] @relation("ChatContactPermissionCreator")
  treatmentRecordsPerformed       CustomerTreatmentRecord[] @relation("TreatmentPerformedBy")
  attendanceLogs                  AttendanceLog[]
  walletLogsPerformed             WalletLog[]             @relation("WalletLogPerformedBy")
  financialRecordsPerformed       FinancialRecord[]       @relation("FinancialRecordPerformedBy")
  serviceRecordsAsStaff           ServiceRecord[]         @relation("ServiceRecordStaff")
  serviceRecordsRolledBack        ServiceRecord[]         @relation("ServiceRecordRollback")
  exosomeConsentLogsOperated      ExosomeConsentLog[]
  courseRefundLogsOperated        CourseRefundToCreditLog[]
  courseConversionLogsOperated    CourseConversionLog[]
  pettyCashLogsPerformed          PettyCashLog[]          @relation("PettyCashLogPerformedBy")

  @@map("users")
}

model Store {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  name           String
  phone          String?
  address        String?
  note           String?
  isActive         Boolean   @default(true) @map("is_active")
  pettyCashBalance Int       @default(0)    @map("petty_cash_balance")
  features         Json      @default("{}") @map("features")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  users     User[]
  customers Customer[]

  inventory        StoreInventory[]
  inventoryLogs    InventoryLog[]
  conversations    Conversation[]
  restockRequests  RestockRequest[]
  contactMessages  ContactMessage[]
  attendanceLogs   AttendanceLog[]
  serviceItems     ServiceItem[]
  promotionPlans   PromotionPlan[]
  walletLogs       WalletLog[]
  customerCourses  CustomerCourse[]
  financialRecords FinancialRecord[]
  serviceRecords   ServiceRecord[]
  pettyCashLogs    PettyCashLog[]

  @@map("stores")
}

model Customer {
  id           Int     @id @default(autoincrement())
  name         String
  phone        String?
  line         String?
  email        String?
  address      String?
  note         String?
  nationalId   String? @map("national_id")
  customerCode String? @unique @map("customer_code")
  isExosomeUser              Boolean   @default(false) @map("is_exosome_user")
  exosomeConsentSignatureUrl String?   @map("exosome_consent_signature_url")
  hasExosomeConsent          Boolean   @default(false) @map("has_exosome_consent")
  exosomeConsentSignedAt     DateTime? @map("exosome_consent_signed_at")
  storeCredit                Decimal   @default(0) @db.Decimal(12, 2) @map("store_credit")

  storeId   Int   @map("store_id")
  store     Store @relation(fields: [storeId], references: [id])
  createdBy Int   @map("created_by")
  creator   User  @relation("CreatedBy", fields: [createdBy], references: [id])

  // 文件（上傳照片合成的 PDF）路徑，跟下面的 disclaimer 是兩份獨立的東西：
  // disclaimer 是固定法律文字＋電子簽名（沒有真正的「掃描檔」），document 是真的有一份 PDF 檔案要雙方簽。
  documentPath String? @map("document_path")

  // 免責聲明書 PDF 路徑（依 DisclaimerTemplate.sections 動態排版產生，每次簽署後覆寫存檔）
  disclaimerPath String? @map("disclaimer_path")

  // 快取欄位：永遠指向 signatures 表裡最新一筆對應紀錄，真正證據在 Signature 表
  documentCustomerSignedAt DateTime? @map("document_customer_signed_at")
  documentStaffSignedAt    DateTime? @map("document_staff_signed_at")
  documentStaffId          Int?      @map("document_staff_id")
  documentStaff            User?     @relation("DocumentStaff", fields: [documentStaffId], references: [id])

  disclaimerCustomerSignedAt DateTime? @map("disclaimer_customer_signed_at")
  disclaimerStaffSignedAt    DateTime? @map("disclaimer_staff_signed_at")
  disclaimerStaffId          Int?      @map("disclaimer_staff_id")
  disclaimerStaff            User?     @relation("DisclaimerStaff", fields: [disclaimerStaffId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  signatures Signature[]

  inventoryLogs           InventoryLog[]
  treatmentRecords        CustomerTreatmentRecord[]
  wallet                  CustomerWallet?
  walletLogs              WalletLog[]
  customerCourses         CustomerCourse[]
  serviceRecords          ServiceRecord[]
  exosomeConsentLogs      ExosomeConsentLog[]
  courseRefundLogs        CourseRefundToCreditLog[]
  courseConversionLogs    CourseConversionLog[]

  @@index([name])
  @@index([phone])
  @@index([storeId, phone])
  @@map("customers")
}

/// Append-only：應用層與 DB 權限都不開放 UPDATE/DELETE，重新簽名一律新增一筆。
model Signature {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  documentType DocumentType @map("document_type")
  signerRole   SignerRole   @map("signer_role")

  signerUserId Int?  @map("signer_user_id") // 顧客簽名時為 null
  signerUser   User? @relation(fields: [signerUserId], references: [id])

  signatureImageUrl   String @map("signature_image_url") // 物件儲存路徑，非 base64 進 DB
  signaturePointsJson Json?  @map("signature_points_json")

  contentSnapshot Json   @map("content_snapshot") // 簽署當下的聲明書內容快照，凍結版本
  contentHash     String @map("content_hash") // SHA-256(contentSnapshot)
  recordHash      String @map("record_hash") // SHA-256(上述所有欄位串接)，用於事後完整性驗證

  signedAt   DateTime @map("signed_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  deviceInfo String?  @map("device_info")

  createdAt DateTime @default(now()) @map("created_at")
  // 沒有 updatedAt、沒有 deletedAt — 此表禁止 UPDATE/DELETE

  @@index([customerId, documentType])
  @@map("signatures")
}

/// 免責聲明書條款內容，管理員之後可在後台修改文字（編輯介面尚未實作，目前先靠 seed/直接改 DB）。
/// 每次「修改」是新增一筆新 version 並把舊的 isActive 設為 false，不直接覆寫舊內容——
/// 因為已經簽署過的 Signature.contentSnapshot 是凍結副本，不受條款之後被修改影響，
/// 但這張表本身保留每個版本的歷史，方便對帳「這次簽的到底是哪一版條款」。
model DisclaimerTemplate {
  id        Int      @id @default(autoincrement())
  version   String   @unique
  title     String
  /// DisclaimerSection[]：[{ heading, paragraphs: string[], requiresSignature: boolean }]
  /// requiresSignature 是「未來簡單設定簽名位置」的機制本身——管理員之後編輯內容時
  /// 只要切換這個布林值，PDF 排版引擎（disclaimer-pdf.util.ts）就會自動在這段後面
  /// 加一個簽名錨點，完全不需要手動指定任何 x/y 座標。
  sections  Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("disclaimer_templates")
}

/// 商品目錄，僅 admin 以上維護。SKU 唯一，供 StoreInventory / InventoryLog 引用。
model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique
  name        String
  unit        String?
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  storeInventory   StoreInventory[]
  inventoryLogs    InventoryLog[]
  restockRequests  RestockRequest[]
  treatmentRecords CustomerTreatmentRecord[]

  @@map("products")
}

/// 每個 (store, product) 只會有一筆現有庫存快取列；真實異動歷史在 InventoryLog，
/// 這張表只是「目前數量」的查詢用快取，數量不可為負由應用層保證，schema 不強制。
model StoreInventory {
  id        Int     @id @default(autoincrement())
  storeId   Int     @map("store_id")
  store     Store   @relation(fields: [storeId], references: [id])
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, productId])
  @@map("store_inventories")
}

/// 庫存異動的帳本：每次進貨/消耗/調整/調撥都新增一筆，用來事後重算/對帳
/// StoreInventory.quantity 是否正確。quantity 一律為正數，方向/語意由 type 決定
/// （而非用正負號表示方向）——這樣 adjustment（盤點校正，方向不固定）才不會跟
/// restock/consumption 混淆，對帳時可直接用 type 篩選做 SUM，不依賴正負號慣例。
model InventoryLog {
  id       Int                   @id @default(autoincrement())
  type     InventoryMovementType
  quantity Int

  storeId   Int     @map("store_id")
  store     Store   @relation(fields: [storeId], references: [id])
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  performedBy Int  @map("performed_by")
  performer   User @relation(fields: [performedBy], references: [id])

  /// 店長在顧客身上消耗庫存（如療程用掉一單位）時連結到該顧客；
  /// 進貨/調撥等不涉及顧客的異動則為 null，故必須是 optional。
  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])

  reason String?

  createdAt DateTime @default(now()) @map("created_at")
  // 無 updatedAt/deletedAt：此表是異動帳本，不可修改既有紀錄

  @@index([storeId, productId])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@map("inventory_logs")
}

/// 分店向「同區經銷商」提出的補貨請求：店長提出時不是直接異動庫存（庫存異動要等貨真的到了，
/// 由店長另外用 InventoryLog 的 restock 類型記一筆），這張表純粹是「請求／待辦」的追蹤，
/// 經銷商在自己的庫存管理畫面看到這些請求，補完貨之後勾選完成——isCompleted 只是一個待辦
/// 打勾狀態，不會自動連動任何庫存數字異動。
model RestockRequest {
  id        Int     @id @default(autoincrement())
  storeId   Int     @map("store_id")
  store     Store   @relation(fields: [storeId], references: [id])
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  note     String?

  requestedBy Int  @map("requested_by")
  requester   User @relation("RestockRequestedBy", fields: [requestedBy], references: [id])

  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  completedBy Int?      @map("completed_by")
  completer   User?     @relation("RestockCompletedBy", fields: [completedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId, isCompleted])
  @@map("restock_requests")
}

enum InquiryCategoryKind {
  /// 加盟諮詢：訊息自動讓「所在地區對應的經銷商」看到，經銷商直接處理，不會轉給特定分店
  franchise
  /// 體驗諮詢：訊息先讓所在地區的經銷商看到，經銷商視情況轉給特定分店（manager 才看得到）
  experience
  /// 其他：保留彈性，之後後台新增類別預設用這個，不會自動分派給任何人，只有 admin 看得到
  other
}

// ─── ERP/POS 擴充 Enums ──────────────────────────────────────────────────────

enum PaymentMethod {
  cash
  transfer
  line_pay
  credit_card
}

enum PettyCashActionType {
  add              // 補充備用金（店長/admin 手動補充）
  remove           // 移除備用金（店長/admin 手動移除）
  outsource_deduct // 外包支出扣款（自動由 outsource_payout 觸發）
  expense_deduct   // 日常支出現金付款扣款（自動由 daily_expense+cash 觸發）
}

enum FinancialRecordType {
  income
  expense
}

/// 帳務分類：與 FinancialRecord.category 搭配，決定如何聯動 Store.pettyCashBalance
enum FinancialCategory {
  sales                 // 單次/課程營業收入
  top_up                // 儲值收入
  outsource_payout      // 外包人員現金日結支出（應用層從 pettyCashBalance 扣）
  daily_expense         // 日常雜支
  petty_cash_replenish  // 備用金補充（限店長/admin，應用層加到 pettyCashBalance）
}

enum ConsumptionType {
  single_purchase   // 單次消費，現場付款
  wallet_deduction  // 扣儲值金
  course_deduction  // 扣課程堂數
}

enum PromotionPlanType {
  top_up_bonus   // 儲值優惠（儲 X 送 Y）
  course_bundle  // 課程套組（N 堂）
}

enum WalletMovementType {
  top_up     // 儲值（增加餘額）
  deduction  // 扣款（消費/退費）
}

/// 「聯絡我們」表單的詢問類別，後台可以新增/編輯/上下架——kind 決定這個類別建立的訊息要怎麼分派
/// （見 ContactMessage 的說明），不是單純的顯示文字而已。
model InquiryCategory {
  id        Int                 @id @default(autoincrement())
  name      String
  kind      InquiryCategoryKind @default(other)
  isActive  Boolean             @default(true) @map("is_active")
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  messages ContactMessage[]

  @@map("inquiry_categories")
}

/// 前台「聯絡我們」頁面送出的表單訊息。region 是從訪客填的台灣縣市（city）換算出來的
/// 北/中/南分區，跟 Store.region／User.region 是同一套三分區，分派經銷商時才能直接比對——
/// city 本身只是給後台顯示「訪客實際填的縣市」，分派邏輯一律看 region。
model ContactMessage {
  id       Int     @id @default(autoincrement())
  name     String
  phone    String?
  email    String?
  city     String
  region   Region
  message  String?

  categoryId Int
  category   InquiryCategory @relation(fields: [categoryId], references: [id])

  /// 體驗諮詢被經銷商轉給特定分店後才會有值；加盟諮詢/其他類別不會用到這兩個欄位
  storeId     Int?      @map("store_id")
  store       Store?    @relation(fields: [storeId], references: [id])
  forwardedAt DateTime? @map("forwarded_at")
  forwardedBy Int?      @map("forwarded_by")
  forwarder   User?     @relation("ContactMessageForwardedBy", fields: [forwardedBy], references: [id])

  isHandled Boolean  @default(false) @map("is_handled")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([region, categoryId])
  @@index([storeId])
  @@map("contact_messages")
}

/// 以主題為單位的內部訊息串（調貨需求／顧客表單詢問／一般聊天）。
model Conversation {
  id     Int                @id @default(autoincrement())
  type   ConversationType
  status ConversationStatus @default(open)
  title  String

  creatorId Int  @map("creator_id")
  creator   User @relation("ConversationCreator", fields: [creatorId], references: [id])

  storeId Int   @map("store_id")
  store   Store @relation(fields: [storeId], references: [id])

  /// 結案稽核：「這個調貨需求是誰結的、何時結的」，內部工單常見的查證需求，
  /// 現在加比之後 retrofit 容易（不需要對舊資料補預設值）。
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy Int?      @map("resolved_by")
  resolver   User?     @relation("ConversationResolver", fields: [resolvedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([storeId, status])
  @@map("conversations")
}

/// Conversation/User 多對多 join table。lastReadAt 是 WebSocket 已讀事件的計算基準：
/// 訊息 createdAt > participant.lastReadAt 即為該使用者尚未讀取，前端未讀數字/已讀勾勾都靠這個欄位算；
/// joinedAt 記錄何時被加入此對話，供稽核用。
model ConversationParticipant {
  id Int @id @default(autoincrement())

  conversationId Int          @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

/// 對話內的單則訊息。v1 不支援編輯/刪除（內部工具，刻意保持簡單）。
/// status 是給 WebSocket 即時更新用的（sent → delivered → read），
/// attachmentUrl 是 nullable——純文字訊息不需要檔案，調貨需求/顧客表單截圖才會帶。
model Message {
  id Int @id @default(autoincrement())

  conversationId Int          @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId Int  @map("sender_id")
  sender   User @relation(fields: [senderId], references: [id])

  body   String
  status MessageStatus @default(sent)

  /// 圖片/檔案儲存路徑，沿用 customer-file-storage.util.ts 的本機儲存模式
  /// （之後換 S3/MinIO 物件儲存時，呼叫端完全不用改）。
  attachmentUrl  String? @map("attachment_url")
  attachmentType String? @map("attachment_type")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// 經銷商/店長預設只看得到「自己的上游與下游」（沿用 ChatService 內算出來的 region/store 規則），
/// 這張表是 admin/system_admin 用來覆寫某個 user 預設清單的明細——
/// 一旦這個 user 在這張表裡有任何一筆紀錄，就代表「改用這份清單」取代預設算法，
/// 不是「在預設清單之外額外加人」，所以管理畫面儲存時是整批覆寫（先刪全部、再寫入新的一份），
/// 不提供單筆增減 API，避免「現在到底是預設還是被改過、改了哪幾筆」這種狀態難以追蹤。
/// 把這份覆寫清空（刪掉所有列）就等於「恢復預設」，不需要額外的 isDefault 旗標欄位。
model ChatContactPermission {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation("ChatContactPermissionOwner", fields: [userId], references: [id])

  contactUserId Int  @map("contact_user_id")
  contactUser   User @relation("ChatContactPermissionContact", fields: [contactUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  /// 哪個 admin/system_admin 設定的，供稽核「這份覆寫清單是誰調整的」
  createdBy Int  @map("created_by")
  creator   User @relation("ChatContactPermissionCreator", fields: [createdBy], references: [id])

  @@unique([userId, contactUserId])
  @@map("chat_contact_permissions")
}

/// 拖拉式建置器的頁面資料：content 是編輯器產出的區塊/樣式結構（取代 Version 1 的 data.json 檔案），
/// 前台用 slug 查已發布版本渲染，後台用同一張表的 isPublished 控制要不要曝光給前台。
model Page {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  metaDescription String?  @map("meta_description")
  content         Json
  isPublished     Boolean  @default(false) @map("is_published")
  /// 全站只會有一個頁面是首頁（"/" 顯示的內容）——在 service 層保證唯一性（設某頁為首頁時，
  /// 自動把舊的首頁取消掉），不是用 DB 唯一索引限制，因為「目前沒有任何頁面是首頁」也是合法狀態。
  isHomepage      Boolean  @default(false) @map("is_homepage")
  /// 是否出現在前台導覽列（Nav Bar）；navOrder 決定排序（小的在前），同 order 用 id 當次要排序。
  showInNav       Boolean  @default(true) @map("show_in_nav")
  navOrder        Int      @default(0) @map("nav_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  articles        Article[]

  @@map("pages")
}

/// 「版型」是預先排好的一組區塊（跟 Page.content 同一種 Puck JSON 結構），存成獨立的資料表
/// 而不是寫死在前端程式碼裡，admin/system_admin 可以直接在後台用拖拉編輯器設計、儲存、之後
/// 重複套用——跟建立 Page 時選的「內建版型」（blank/news-article/landing-page，純前端常數）
/// 是互補關係：內建版型是程式碼層級的固定起手式，這張表是營運過程中可以持續累積的自訂版型庫。
model PageTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  content     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("page_templates")
}

/// 文章（最新消息/部落格）：跟 Page 是平行但獨立的概念——Page 是「整頁」（首頁/關於我們），
/// Article 是「會持續累積、需要列表＋站內搜尋」的內容單位。content 一樣是 Puck 區塊 JSON，
/// 可以重複使用同一套拖拉編輯器跟區塊庫。excerpt 是列表頁用的摘要（不用每次都把整篇 content
/// 解析出來顯示），publishedAt 跟 isPublished 分開存：之後若要支援「排定發布時間」可以直接用
/// publishedAt 排序/篩選，不用額外加欄位。
model Article {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  excerpt     String?
  coverImageUrl String? @map("cover_image_url")
  content     Json
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  /// 文章「要放在哪一個」頁面底下（例如美容原液頁面的相關文章），選填——刪掉那個頁面時只把
  /// 這個欄位清空（SetNull），不會把文章也一起刪掉，文章本身是獨立存在的內容單位。
  categoryPageId Int?     @map("category_page_id")
  categoryPage   Page?    @relation(fields: [categoryPageId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("articles")
}

/// 顧客商品使用紀錄：記錄每次服務選用了哪個商品，與庫存系統無關（不扣庫存），
/// 僅做為服務歷程追蹤。照片以 JSON 陣列存相對路徑（同 document/disclaimer PDF 的 storage 慣例）。
model CustomerTreatmentRecord {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId   Int     @map("product_id")
  product     Product @relation(fields: [productId], references: [id])

  performedById Int  @map("performed_by_id")
  performedBy   User @relation("TreatmentPerformedBy", fields: [performedById], references: [id])

  performedAt DateTime @default(now()) @map("performed_at")
  note        String?

  /// 照片相對路徑陣列，e.g. ["/api/v2/cms/uploads/abc.jpg"]，前端可直接用 <img src=...>
  photos      Json     @default("[]")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_treatment_records")
}

// ─── ERP/POS 擴充 Models ─────────────────────────────────────────────────────

/// 員工打卡帳本（Append-only）。clockOutAt 為 null 代表尚未下班（open clock）。
model AttendanceLog {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  storeId    Int       @map("store_id")
  store      Store     @relation(fields: [storeId], references: [id])
  clockInAt  DateTime  @map("clock_in_at")
  clockOutAt DateTime? @map("clock_out_at")
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([storeId, clockInAt])
  @@map("attendance_logs")
}

/// 服務/課程項目目錄。storeId 為 null 代表全域通用項目（admin 建立）；非 null 代表分店自訂項目。
/// 有軟刪除（下架但不影響歷史紀錄外鍵完整性）。
model ServiceItem {
  id            Int       @id @default(autoincrement())
  storeId       Int?      @map("store_id")
  store         Store?    @relation(fields: [storeId], references: [id])
  name          String
  price         Int
  isOutsourced  Boolean   @default(false) @map("is_outsourced")
  outsourceCost Int?      @map("outsource_cost")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  promotionPlanItems PromotionPlanItem[]
  customerCourses    CustomerCourse[]
  serviceRecords     ServiceRecord[]

  @@index([storeId])
  @@map("service_items")
}

/// 優惠方案（多品項組合包架構）。
/// top_up_bonus：儲值優惠（售價 X 元，贈 bonusAmount 儲值金）；
/// course_bundle：課程套組（售價 X 元，透過 PromotionPlanItem 定義各課程堂數）。
model PromotionPlan {
  id          Int               @id @default(autoincrement())
  storeId     Int               @map("store_id")
  store       Store             @relation(fields: [storeId], references: [id])
  name        String
  type        PromotionPlanType
  price       Int
  bonusAmount Int?              @map("bonus_amount")   // top_up_bonus 時有效
  isActive    Boolean           @default(true)          @map("is_active")
  createdAt   DateTime          @default(now())         @map("created_at")
  updatedAt   DateTime          @updatedAt              @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  items PromotionPlanItem[]

  @@index([storeId])
  @@map("promotion_plans")
}

/// 方案明細（一對多）：一個 PromotionPlan 可包含多個課程品項，
/// 每筆記錄代表「此方案包含 serviceItem X 共 sessions 堂」。
model PromotionPlanItem {
  id            Int          @id @default(autoincrement())
  planId        Int          @map("plan_id")
  plan          PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  serviceItemId Int          @map("service_item_id")
  serviceItem   ServiceItem  @relation(fields: [serviceItemId], references: [id])
  sessions      Int          // 此品項在方案內包含的堂數

  @@index([planId])
  @@map("promotion_plan_items")
}

/// 顧客錢包（一對一）。balance 是本金餘額，bonusBalance 是贈送金餘額。
/// 金額永不為負由應用層保證。餘額變動歷史在 WalletLog。
model CustomerWallet {
  id           Int      @id @default(autoincrement())
  customerId   Int      @unique @map("customer_id")
  customer     Customer @relation(fields: [customerId], references: [id])
  balance      Int      @default(0)
  bonusBalance Int      @default(0) @map("bonus_balance")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("customer_wallets")
}

/// 儲值金異動帳本（Append-only）。amount 永遠為正整數，type 決定增減方向。
model WalletLog {
  id            Int                @id @default(autoincrement())
  customerId    Int                @map("customer_id")
  customer      Customer           @relation(fields: [customerId], references: [id])
  storeId       Int                @map("store_id")
  store         Store              @relation(fields: [storeId], references: [id])
  type          WalletMovementType
  amount        Int
  bonusAmount   Int                @default(0) @map("bonus_amount")
  performedById Int                @map("performed_by_id")
  performedBy   User               @relation("WalletLogPerformedBy", fields: [performedById], references: [id])
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([customerId])
  @@index([storeId])
  @@map("wallet_logs")
}

/// 顧客擁有的課程。顧客購買套組後產生一筆。usedSessions 由應用層在每次 ServiceRecord 後遞增。
model CustomerCourse {
  id            Int         @id @default(autoincrement())
  customerId    Int         @map("customer_id")
  customer      Customer    @relation(fields: [customerId], references: [id])
  serviceItemId Int         @map("service_item_id")
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id])
  storeId       Int         @map("store_id")
  store         Store       @relation(fields: [storeId], references: [id])
  totalSessions Int         @map("total_sessions")
  usedSessions  Int         @default(0) @map("used_sessions")
  purchasePrice Int?        @map("purchase_price")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  refundLogs               CourseRefundToCreditLog[]
  conversionLogsAsSource   CourseConversionLog[]     @relation("ConversionFromCourse")
  conversionLogsAsTarget   CourseConversionLog[]     @relation("ConversionToCourse")

  @@index([customerId])
  @@map("customer_courses")
}

/// 備用金異動日誌（獨立系統）。
/// 備用金補充/移除/被扣款的每一筆都記在這裡，與 FinancialRecord 完全分離。
/// balanceAfter 由應用層在 transaction 內計算並寫入（不依賴 trigger）。
model PettyCashLog {
  id            Int                 @id @default(autoincrement())
  storeId       Int                 @map("store_id")
  store         Store               @relation(fields: [storeId], references: [id])
  action        PettyCashActionType
  amount        Int
  balanceAfter  Int                 @map("balance_after")
  note          String?
  performedById Int                 @map("performed_by_id")
  performedBy   User                @relation("PettyCashLogPerformedBy", fields: [performedById], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@map("petty_cash_logs")
}

/// 分店流水總帳（Append-only，純收支）。
/// outsource_payout 同時會在 PettyCashLog 寫入 outsource_deduct；
/// daily_expense 現金付款時同時在 PettyCashLog 寫入 expense_deduct。
/// petty_cash_replenish 已廢棄，新操作改用 PettyCashLog。
model FinancialRecord {
  id            Int                 @id @default(autoincrement())
  storeId       Int                 @map("store_id")
  store         Store               @relation(fields: [storeId], references: [id])
  type          FinancialRecordType
  category      FinancialCategory
  amount        Int
  paymentMethod PaymentMethod       @map("payment_method")
  performedById Int                 @map("performed_by_id")
  performedBy   User                @relation("FinancialRecordPerformedBy", fields: [performedById], references: [id])
  description   String?
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@map("financial_records")
}

/// 服務與 POS 結帳紀錄（Append-only）。
/// consumptionType 為 wallet_deduction 或 course_deduction 時，
/// customerSignatureUrl 業務上必填（應用層強制）。staffId 用於日後業績抽成計算。
model ServiceRecord {
  id                   Int             @id @default(autoincrement())
  customerId           Int             @map("customer_id")
  customer             Customer        @relation(fields: [customerId], references: [id])
  storeId              Int             @map("store_id")
  store                Store           @relation(fields: [storeId], references: [id])
  staffId              Int             @map("staff_id")
  staff                User            @relation("ServiceRecordStaff", fields: [staffId], references: [id])
  serviceItemId        Int             @map("service_item_id")
  serviceItem          ServiceItem     @relation(fields: [serviceItemId], references: [id])
  consumptionType      ConsumptionType @map("consumption_type")
  amountPaid           Int?            @map("amount_paid")
  /// 多重支付明細，格式：[{ method: 'cash', amount: 500 }, { method: 'line_pay', amount: 300 }]
  /// 僅 single_purchase 時使用；wallet/course_deduction 為 null
  payments             Json?
  sessionsDeducted     Int?            @map("sessions_deducted")
  customerSignatureUrl String?         @map("customer_signature_url")
  signatureAt          DateTime?       @map("signature_at")
  outsourcePaidAt      DateTime?       @map("outsource_paid_at")
  note                 String?
  isRolledBack         Boolean         @default(false) @map("is_rolled_back")
  rolledBackAt         DateTime?       @map("rolled_back_at")
  rollbackOperatorId   Int?            @map("rollback_operator_id")
  rollbackOperator     User?           @relation("ServiceRecordRollback", fields: [rollbackOperatorId], references: [id])
  createdAt            DateTime        @default(now()) @map("created_at")

  @@index([customerId])
  @@index([storeId, createdAt])
  @@index([staffId])
  @@map("service_records")
}

/// 外泌體使用同意書補簽紀錄（舊顧客補簽用）
model ExosomeConsentLog {
  id              Int      @id @default(autoincrement())
  customerId      Int      @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id])
  signedAt        DateTime @default(now()) @map("signed_at")
  signatureUrl    String   @map("signature_url")
  signaturePoints Json?    @map("signature_points")
  operatorId      Int      @map("operator_id")
  operator        User     @relation(fields: [operatorId], references: [id])
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("exosome_consent_logs")
}

/// 退課程轉儲值金歷程
model CourseRefundToCreditLog {
  id                Int            @id @default(autoincrement())
  customerId        Int            @map("customer_id")
  customer          Customer       @relation(fields: [customerId], references: [id])
  customerCourseId  Int            @map("customer_course_id")
  customerCourse    CustomerCourse @relation(fields: [customerCourseId], references: [id])
  refundedSessions  Int            @map("refunded_sessions")
  calculatedAmount  Decimal        @db.Decimal(12, 2) @map("calculated_amount")
  finalAmount       Decimal        @db.Decimal(12, 2) @map("final_amount")
  operatorId        Int            @map("operator_id")
  operator          User           @relation(fields: [operatorId], references: [id])
  remark            String?
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([customerId])
  @@map("course_refund_to_credit_logs")
}

/// 課程轉換歷程（舊課程 → 新課程）
model CourseConversionLog {
  id                 Int            @id @default(autoincrement())
  customerId         Int            @map("customer_id")
  customer           Customer       @relation(fields: [customerId], references: [id])
  fromCourseId       Int            @map("from_course_id")
  fromCourse         CustomerCourse @relation("ConversionFromCourse", fields: [fromCourseId], references: [id])
  toCourseId         Int            @map("to_course_id")
  toCourse           CustomerCourse @relation("ConversionToCourse", fields: [toCourseId], references: [id])
  convertedSessions  Int            @map("converted_sessions")
  operatorId         Int            @map("operator_id")
  operator           User           @relation(fields: [operatorId], references: [id])
  remark             String?
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([customerId])
  @@map("course_conversion_logs")
}
